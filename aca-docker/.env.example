# Values in this file are examples only and must not be used for AAT/production.
APPINSIGHTS_INSTRUMENTATIONKEY=local-only
WIREMOCK_SERVER_MAPPINGS_PATH=wiremock
SERVER_PORT=4454
MANAGE_CASE_S2S_KEY=replace-with-local-s2s-key
IDAM_CLIENT_SECRET=replace-with-local-client-secret
XUIWEBAPP_IDAM_CLIENT_SECRET=replace-with-local-client-secret
CCD_API_GATEWAY_IDAM_CLIENT_SECRET=replace-with-local-client-secret
